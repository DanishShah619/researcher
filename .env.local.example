# CognoDB connection (copy to .env.local and fill in; never commit real values)
COGNODB_URI="bolt+s://<your-instance-id>.databases.cognodb.cloud"
COGNODB_USER="cognodb"
COGNODB_PASSWORD="<your-password>"

# Optional: log DB sessions slower than this many milliseconds (default 500)
# COGNODB_SLOW_QUERY_MS=500

# Optional: per-client request limit on /apis/* routes (default 60 per minute)
# API_RATE_LIMIT_PER_MINUTE=60

# The deployed app only reads. Prefer a read-only database user here in production
# and keep admin credentials for running `npm run seed` locally (see README).
